    bool eval_g(Ipopt::Index n, const Number* x, bool new_x, Ipopt::Index m, Number* g) override {
        
        int num_vars = n_; // Number of optimization variables per group
        const Number* x_vars = x;
        const Number* y_vars = x + num_vars;
        const Number* theta_vars = x + 2 * num_vars;
        const Number* v_vars = x + 3 * num_vars;
        const Number* delta_vars = x + 4 * num_vars;

        int constraint_index = 0;
        std::cout<< " eval_g Boundary constraint constraint_index  " << constraint_index << std::endl; 
        // Kinematic constraints for car-like dynamics
        for (int i = 0; i < num_vars - 1; ++i) {
            // x_t+1 = x_t + delta_t * v * cos(theta)
            g[constraint_index++] = x_vars[i + 1] - (x_vars[i] + delta_t_ * v_vars[i] * std::cos(theta_vars[i]));
            // y_t+1 = y_t + delta_t * v * sin(theta)
            g[constraint_index++] = y_vars[i + 1] - (y_vars[i] + delta_t_ * v_vars[i] * std::sin(theta_vars[i]));
            // theta_t+1 = theta_t + delta_t * v * tan(delta) / L
            g[constraint_index++] = theta_vars[i + 1] - (theta_vars[i] + delta_t_ * v_vars[i] * std::tan(delta_vars[i]) / wheelbase_);
        }
        std::cout<< " eval_g Boundary constraint constraint_index  " << constraint_index << std::endl; 
        // Velocity and steering angle constraints
        for (int i = 0; i < num_vars; ++i) {
            // Velocity constraint (0 <= v <= v_max)
            g[constraint_index++] = v_vars[i];
            // Steering angle constraint (-delta_max <= delta <= delta_max)
            g[constraint_index++] = delta_vars[i];
        }
        std::cout<< " eval_g Velocity and steering angle  " << constraint_index << std::endl; 
        // Boundary constraints for polygon
        for (int i = 0; i < num_vars; ++i) {
            for (int j = 0; j < 2; ++j) {
                // Boundary constraint: A_p * [x; y] <= b_p
                g[constraint_index++] = x_vars[i] * A_p_(j, 0) + y_vars[i] * A_p_(j, 1);
            }
        }
        std::cout<< " eval_g Boundary constraints  " << constraint_index << std::endl; 
        return true;
    }

    bool eval_jac_g(Ipopt::Index n, const Number* x, bool new_x, Ipopt::Index m, Ipopt::Index nele_jac, Ipopt::Index* iRow, Ipopt::Index* jCol, Number* values) override {
        std::cout<< "------------eval_jac_g--------------- "  << std::endl; 
        if (values == nullptr) {
            for (Ipopt::Index i = 0; i < m; ++i) {
                iRow[i] = i;
                jCol[i] = i;  // Simple sparse structure, fill in row/column indices
            }
        } else {
            // Assign values for nonzero Jacobian entries
            for (Ipopt::Index i = 0; i < m; ++i) {
                values[i] = 0.0;
            }
        }

        // if (values == nullptr) {
        //     // First call: Define the structure (sparsity pattern) of the Jacobian.
