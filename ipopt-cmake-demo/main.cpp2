    std::vector<double> x_opt_, y_opt_, delta_opt_, theta_opt_, v_opt_;
    double v_max_{1.0};
    double delta_t_ = 0.1;
    double wheelbase_ = 1.0;
    Eigen::MatrixXd A_p_;
    Eigen::VectorXd b_p_;
    double curvature_weight_{1.0};
    double curvature_rate_weight_{1.0};
    double distance_weight_{1.0};
    double delta_max_{1.0};

};

int main() {

    
  Eigen::MatrixXd data(41, 3);
  data << 0.171036, 0.015299, 1.66001
    ,0.270638, 0.0242084, 1.66001
    ,0.37024, 0.0331177, 1.66001
