        //     // Second call: Compute the actual values of the Jacobian at the point x.
        //     // Populate 'values' array with Jacobian values for g(x).

        //     Index idx = 0;
        //     for (Index i = 0; i < m; i++) {      // For each constraint
        //         for (Index j = 0; j < n; j++) {  // For each variable
        //             // Example calculation of partial derivative for Jacobian value
        //             values[idx] = 1.0;  // Replace with actual computation
        //             idx++;
        //         }
        //     }
        // }
        std::cout<< "------------eval_jac_g--------------- "  << std::endl;
        return true;
    }

    void finalize_solution(SolverReturn status, Ipopt::Index n, const Number* x, const Number* z_L, const Number* z_U,
                           Ipopt::Index m, const Number* g, const Number* lambda, Number obj_value,
                           const IpoptData* ip_data, IpoptCalculatedQuantities* ip_cq) override {
        for (Ipopt::Index i = 0; i < n_; ++i) {
            x_opt_[i] = x[i];
            y_opt_[i] = x[i + n_];
            theta_opt_[i] = x[i + 2 * n_];
            v_opt_[i] = x[i + 3 * n_];
            delta_opt_[i] = x[i + 4 * n_];
        }
        // visualize_result();
    }

