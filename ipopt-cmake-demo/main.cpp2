class PathOptimizationNLP : public TNLP {
public:
    PathOptimizationNLP(const std::vector<double>& x_list, const std::vector<double>& y_list, const std::vector<double>& theta_list
        ,  Eigen::MatrixXd A, Eigen::VectorXd b)
        : x_list_(x_list), y_list_(y_list), theta_list_(theta_list), n_(x_list.size())
        , x_opt_(x_list.size()), y_opt_(y_list.size()), delta_opt_(y_list.size())
        , theta_opt_(x_list.size()), v_opt_(y_list.size())
        , A_p_(A), b_p_(b) {}

    virtual ~PathOptimizationNLP() {}

    bool get_nlp_info(Ipopt::Index& n, Ipopt::Index& m, Ipopt::Index& nnz_jac_g, Ipopt::Index& nnz_h_lag, IndexStyleEnum& index_style) override {
        n = 5 * n_;  // x, y, and d for each point
        m = (n_ - 1) * 3 + (n_) * 2 + 2 * (n_);  // 2 velocity constraints per interval
        nnz_jac_g = m;     // Jacobian has a simple structure in this case
        nnz_h_lag = 0;     // IPOPT will approximate Hessian
        index_style = TNLP::C_STYLE;  // use C-style indexing

        std::cout<< " m " << m << " n " << n << std::endl; 
        return true;
    }

    bool get_bounds_info(Ipopt::Index n, Number* x_l, Number* x_u, Ipopt::Index m, Number* g_l, Number* g_u) override {

        std::cout<< " get_bounds_info m " << m << " n " << n << std::endl; 

        for (Ipopt::Index i = 0; i < n_; ++i) {
            x_l[i] = -1e19;  x_u[i] = 1e19;  // x bounds
            x_l[i + n_] = -1e19; x_u[i + n_] = 1e19;  // y bounds
            // x_l[i + 2 * n_] = -3.1; x_u[i + 2 * n_] = 3.1;  // theta bounds
            // x_l[i + 3 * n_] = -v_max_; x_u[i + 3 * n_] = v_max_;  // v bounds
            // x_l[i + 4 * n_] = -1e19; x_u[i + 4 * n_] = 1e19;  // delta bounds
            x_l[i + 2 * n_] = -1e19; x_u[i + 2 * n_] = 1e19;  // theta bounds
            x_l[i + 3 * n_] = -1e19; x_u[i + 3 * n_] = 1e19;  // v bounds
            x_l[i + 4 * n_] = -1e19; x_u[i + 4 * n_] = 1e19;  // delta bounds
        }
        // Constraint bounds for kinematic constraints (equality constraints)
        int constraint_index = 0;
        int num_vars = n_;
        for (int i = 0; i < num_vars - 1; ++i) {
            // x_t+1 = x_t + delta_t * v * cos(theta)
            g_l[constraint_index] = 0.0;
            g_u[constraint_index] = 0.0;
            constraint_index++;
            // y_t+1 = y_t + delta_t * v * sin(theta)
            g_l[constraint_index] = 0.0;
            g_u[constraint_index] = 0.0;
            constraint_index++;

            // theta_t+1 = theta_t + delta_t * v * tan(delta) / wheelbase
            g_l[constraint_index] = 0.0;
            g_u[constraint_index] = 0.0;
            constraint_index++;
        }

        std::cout<< " kinematic constraints constraint_index  " << constraint_index << std::endl; 

        // Velocity constraint bounds (inequality constraints)
        for (int i = 0; i < num_vars; ++i) {
            g_l[constraint_index] = 0.0;   // Minimum velocity constraint
            g_u[constraint_index] = v_max_; // Maximum velocity constraint
            constraint_index++;
        }

        std::cout<< " Velocity constraint constraint_index  " << constraint_index << std::endl; 

        // Steering angle constraint bounds (inequality constraints)
        for (int i = 0; i < num_vars; ++i) {
            g_l[constraint_index] = -delta_max_;
            g_u[constraint_index] = delta_max_;
            constraint_index++;
        }

        std::cout<< " Steering angle constraint_index  " << constraint_index << std::endl; 

        // Boundary constraint bounds (polygon constraints, inequality constraints)
        for (int i = 0; i < num_vars; ++i) {
            for (int j = 0; j < 2; ++j) {
                // A_p * [x; y] <= b_p
                g_l[constraint_index] = -1e19;
                g_u[constraint_index] = b_p_(j);
                constraint_index++;
            }
        }
        std::cout<< "  Boundary constraint constraint_index  " << constraint_index << std::endl; 
        return true;
    }

    bool eval_h(Ipopt::Index n, 
                         const Ipopt::Number* x, 
                         bool new_x,
                         Ipopt::Number obj_factor, 
                         Ipopt::Index m, 
                         const Ipopt::Number* lambda,
                         bool new_lambda, 
                         Ipopt::Index nele_hess, 
                         Ipopt::Index* iRow,
                         Ipopt::Index* jCol, 
                         Ipopt::Number* values)
  {
    return true;
  }

    bool get_starting_point(Ipopt::Index n, bool init_x, Number* x, bool init_z, Number* z_L, Number* z_U,
                            Ipopt::Index m, bool init_lambda, Number* lambda) override {

        std::cout<< " get_starting_point " << std::endl;
        if (init_x) {
            for (Ipopt::Index i = 0; i < n_; ++i) {
                x[i] = x_list_[i];
                x[i + n_] = y_list_[i];
                x[i + 2 * n_] = theta_list_[i];
                x[i + 3 * n_] = v_max_;
                x[i + 4 * n_] = 0.0;
            }
        }
        std::cout<< " get_starting_point " << std::endl;
        return true;
    }

    bool eval_f(Ipopt::Index n, const Number* x, bool new_x, Number& obj_value) override {
        obj_value = 0.0;
        int num_vars = n_ ;  // Number of variables per group (n-1 because initial pose is fixed)
        const Number* x_vars = x;
        const Number* y_vars = x + num_vars;
        const Number* theta_vars = x + 2 * num_vars;
        const Number* v_vars = x + 3 * num_vars;
        const Number* delta_vars = x + 4 * num_vars;
        std::cout<< " eval_f 1 " << std::endl;
        // Curvature penalty
        for (int i = 0; i < num_vars - 2; ++i) {
            Number dds_x = x_vars[i + 2] - 2 * x_vars[i + 1] + x_vars[i];
            Number dds_y = y_vars[i + 2] - 2 * y_vars[i + 1] + y_vars[i];
            obj_value += curvature_weight_ * (dds_x * dds_x + dds_y * dds_y);
        }
        // Curvature rate penalty
        for (int i = 0; i < num_vars - 3; ++i) {
            Number ddds_x = x_vars[i + 3] - 3 * x_vars[i + 2] + 3 * x_vars[i + 1] - x_vars[i];
            Number ddds_y = y_vars[i + 3] - 3 * y_vars[i + 2] + 3 * y_vars[i + 1] - y_vars[i];
            obj_value += curvature_rate_weight_ * (ddds_x * ddds_x + ddds_y * ddds_y);
        }
        // Distance penalty between consecutive points
        for (int i = 0; i < num_vars - 1; ++i) {
            Number dx = x_vars[i + 1] - x_vars[i];
            Number dy = y_vars[i + 1] - y_vars[i];
            obj_value += distance_weight_ * (dx * dx + dy * dy);
        }
        std::cout<< " eval_f 2 " << std::endl;
        return true;
    }

